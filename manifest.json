
{
  "manifest_version": 3,
  "name": "BDJobs Token Sync",
  "version": "1.0.0",
  "description": "Send the BDJobs job seeker access token to the configured API.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://bdjobs.com/*",
    "https://*.bdjobs.com/*",
    "https://fb8dhvtj-3000.inc1.devtunnels.ms/*"
  ]
}
